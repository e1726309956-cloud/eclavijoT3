<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="eclavijoT3.vResumen"
             Title="vResumen">


    <ContentPage.Resources>

        <!-- Título -->
        <Style x:Key="titulo"
           TargetType="Label">
            <Setter Property="BackgroundColor" Value="#1E3A8A"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- Datos -->
        <Style x:Key="datos"
           TargetType="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextColor" Value="#1F2937"/>
            <Setter Property="BackgroundColor" Value="#F3F4F6"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <!-- Botón -->
        <Style x:Key="botonExportar"
           TargetType="Button">
            <Setter Property="BackgroundColor" Value="#2563EB"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="HeightRequest" Value="50"/>
        </Style>


    </ContentPage.Resources>
    
    <VerticalStackLayout
        Padding="20"
    Spacing="12"
    BackgroundColor="#b1c2e3"
        >
        <Label Text="DATOS DEL CONTACTO"
       Style="{StaticResource titulo}" />

        <Image Source="contacto.png"
                   HeightRequest="100"
                   WidthRequest="100"
                   HorizontalOptions="Center"/>
        <Label x:Name="lblTipo"
                   Style="{StaticResource datos}"/>

        <Label x:Name="lblNumero"
                   Style="{StaticResource datos}"/>

        <Label x:Name="lblNombres"
                   Style="{StaticResource datos}"/>

        <Label x:Name="lblApellidos"
                   Style="{StaticResource datos}"/>

        <Label x:Name="lblFecha"
                   Style="{StaticResource datos}"/>

        <Label x:Name="lblCorreo"
                   Style="{StaticResource datos}"/>

        <Label x:Name="lblSalario"
                   Style="{StaticResource datos}"/>

        <Label x:Name="lblIess"
                   Style="{StaticResource datos}"/>

        <Button
    Text="Exportar TXT"
    Style="{StaticResource botonExportar}"
    Clicked="Button_Clicked"/>
        
    </VerticalStackLayout>
</ContentPage>